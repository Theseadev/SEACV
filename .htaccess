<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent directory listing
    Options -Indexes

    # Legacy asset rewrites to new assets/ folder
    RewriteRule ^(logo\.png|batik-.*|.*-pattern\.svg)$ assets/images/$1 [L]
    RewriteRule ^(admin\.css|style\.css)$ assets/css/$1 [L]
    RewriteRule ^(script\.js)$ assets/js/$1 [L]
    RewriteRule ^banner/(.*)$ assets/banner/$1 [L]

    # Allow direct access to existing files and directories (assets, uploads, etc.)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Send all other requests to index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# ==============================================================================
# GZIP / Deflate Compression (Dramatically reduces file transfer sizes)
# ==============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# ==============================================================================
# Browser Caching & Expires Headers (Instant repeat loads)
# ==============================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 2 days"

    # Images (WebP, PNG, JPG, SVG, ICO)
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"

    # Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Cache Control for static media
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=604800, public"
    </FilesMatch>

    # Disable ETags for faster validation
    Header unset ETag
    FileETag None
</IfModule>
