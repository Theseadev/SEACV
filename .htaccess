<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent directory listing
    Options -Indexes

    # Legacy asset rewrites to new assets/ folder
    RewriteRule ^(logo\.png|batik-.*|.*-pattern\.svg)$ assets/images/$1 [L]
    RewriteRule ^(admin\.css|style\.css)$ assets/css/$1 [L]
    RewriteRule ^(script\.js)$ assets/js/$1 [L]
    RewriteRule ^banner/(.*)$ assets/banner/$1 [L]

    # Allow direct access to existing files and directories (assets, uploads, etc.)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Send all other requests to index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
